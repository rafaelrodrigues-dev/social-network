# ==========================================
# Docker Ignore File for Social Network (Django)
# ==========================================

# Git / Version Control
.git/
.gitignore
.gitattributes

# Environment Variables & Secrets (Sensitive files)
.env
.env.*
*.env
dotenv_files/

# Docker Files (not needed inside the image)
Dockerfile*
docker-compose*.yml
.dockerignore

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Python Bytecode & Cache
**/__pycache__/
**/*.py[cod]
**/*$py.class
*.so
.Python

# Packaging & Distribution
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Testing & Coverage (Unit tests, pytest, coverage)
**/.pytest_cache/
**/.coverage
**/.coverage.*
**/htmlcov/
**/.coveragerc
coverage.xml
nosetests.xml
.hypothesis/
.tox/
.nox/
.cache/

# Type Checking & Linters
**/.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# Database & SQLite files
*.sqlite3
*.sqlite3-journal
**/*.sqlite3
**/*.sqlite3-journal
db.sqlite3

# Logs & Run files
*.log
**/*.log
celerybeat-schedule*
celerybeat.pid

# Django local media & collected data
# (Persistence is handled via Docker volumes)
data/
media/
staticfiles/

# IDEs, Editors & OS Files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
ehthumbs.db

# Documentation & Repo Meta (not needed in container)
README.md
LICENSE
docs/
/site
